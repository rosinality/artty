# The Rust side is reached through JNA and UniFFI's bindings, which find their classes,
# fields and callbacks by reflection: kept whole.
-keep class com.sun.jna.** { *; }
-keep class * extends com.sun.jna.** { *; }
-keep class * implements com.sun.jna.** { *; }
-keep class uniffi.** { *; }
-dontwarn java.awt.**
-dontwarn com.sun.jna.**
