<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: servers and machines' keys go to a backup or a new phone; the key
     earlier builds made doesn't (the Keystore one can't leave the phone at all). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="id_ed25519" />
        <exclude domain="file" path="id_ed25519.pub" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="id_ed25519" />
        <exclude domain="file" path="id_ed25519.pub" />
    </device-transfer>
</data-extraction-rules>
